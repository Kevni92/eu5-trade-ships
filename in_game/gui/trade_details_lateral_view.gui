lateralview = {
	name = "trade_details_lateral_view"

	blockoverride "panel_header" {
		datacontext = "[TradeDetailsLateralView.GetTrade]"
		window_header_alt = {
			using = bg_main_inner_alt
			blockoverride "window_header_alt_color_texture" {
				using = color_default_brown_texture
			}
			blockoverride "header_text" {
				text = "[Trade.GetName]"
				default_format = "#yellow_titles"
			}
		}
	}

	blockoverride "panel_content" {
		datacontext = "[TradeDetailsLateralView.GetTrade]"
		vbox = {
			using = layoutpolicy_expanding
			using = bg_main_inner_notabs_alt
			using = window_main_tabs_margin_alt
			spacing = 6

			# Preserve the Vanilla trade card. Besides the normal trade controls,
			# this keeps the original selected-trade/highlight UI structure present.
			ExistingTradeCard = {
				layoutpolicy_horizontal = expanding
				size = { -1 40 }
				blockoverride "trade_ui_actions" {
					datacontext = "[TradeDetailsLateralView.GetUIAction]"
					using = button_action_provider
				}
				blockoverride "trade_market_names" {
					text_single = {
						autoresize = no
						using = Font_Size_Small
						layoutpolicy_horizontal = expanding
						size = { -1 20 }
						align = left|nobaseline
						text = "[Trade.GetMarketNames]"
						default_format = "#subtle_name"
						block "sort_by_highlight_markets" {}
						using = bg_number_container_bckg
						blockoverride "number_container_extra" {
							alpha = 0.4
							margin = {4 5}
						}
					}
				}
			}

			paper_simple_card = {
				layoutpolicy_horizontal = expanding
				size = { -1 820 }
				vbox = {
					margin = { 12 12 }
					spacing = 4

					text_single = {
						raw_text = "#Y TRADE SHIPPING DEBUG#!"
						fontsize = 18
					}

					text_single = {
						raw_text = "From Market: [Trade.GetFromMarket.GetNameWithNoTooltip]"
					}
					text_single = {
						raw_text = "To Market: [Trade.GetToMarket.GetNameWithNoTooltip]"
					}
					text_single = {
						raw_text = "Shipping Volume: [Trade.GetQuantityOfGoodsActuallyMoved|2]"
					}
					text_single = {
						raw_text = "Desired Volume: [Trade.GetDesiredGoodsShipped|2]"
					}

					text_single = {
						raw_text = "#Y --- FROM ENDPOINT ---#!"
					}
					text_single = {
						visible = "[Trade.GetFromPort.IsValid]"
						raw_text = "#G FromPort: [Trade.GetFromPort.GetNameWithNoTooltip]#!"
					}
					text_single = {
						visible = "[Not(Trade.GetFromPort.IsValid)]"
						raw_text = "#R FromPort: NONE / INVALID#!"
					}

					text_single = {
						visible = "[And(Trade.GetFromPort.IsValid, Trade.GetFromPort.IsCoastal)]"
						raw_text = "FromPort IsCoastal: #G YES#!"
					}
					text_single = {
						visible = "[And(Trade.GetFromPort.IsValid, Not(Trade.GetFromPort.IsCoastal))]"
						raw_text = "FromPort IsCoastal: #R NO#!"
					}

					text_single = {
						visible = "[And(Trade.GetFromPort.IsValid, Trade.GetFromPort.HasPort)]"
						raw_text = "FromPort HasPort: #G YES#!"
					}
					text_single = {
						visible = "[And(Trade.GetFromPort.IsValid, Not(Trade.GetFromPort.HasPort))]"
						raw_text = "FromPort HasPort: #R NO#!"
					}

					text_single = {
						visible = "[And(Trade.GetFromPort.IsValid, Trade.GetFromPort.GetPortSeaZone.IsValid)]"
						raw_text = "#G FromPort SeaZone: [Trade.GetFromPort.GetPortSeaZone.GetNameWithNoTooltip]#!"
					}
					text_single = {
						visible = "[And(Trade.GetFromPort.IsValid, Not(Trade.GetFromPort.GetPortSeaZone.IsValid))]"
						raw_text = "#R FromPort SeaZone: NONE / INVALID#!"
					}

					text_single = {
						raw_text = "#Y --- TO ENDPOINT ---#!"
					}
					text_single = {
						visible = "[Trade.GetToPort.IsValid]"
						raw_text = "#G ToPort: [Trade.GetToPort.GetNameWithNoTooltip]#!"
					}
					text_single = {
						visible = "[Not(Trade.GetToPort.IsValid)]"
						raw_text = "#R ToPort: NONE / INVALID#!"
					}

					text_single = {
						visible = "[And(Trade.GetToPort.IsValid, Trade.GetToPort.IsCoastal)]"
						raw_text = "ToPort IsCoastal: #G YES#!"
					}
					text_single = {
						visible = "[And(Trade.GetToPort.IsValid, Not(Trade.GetToPort.IsCoastal))]"
						raw_text = "ToPort IsCoastal: #R NO#!"
					}

					text_single = {
						visible = "[And(Trade.GetToPort.IsValid, Trade.GetToPort.HasPort)]"
						raw_text = "ToPort HasPort: #G YES#!"
					}
					text_single = {
						visible = "[And(Trade.GetToPort.IsValid, Not(Trade.GetToPort.HasPort))]"
						raw_text = "ToPort HasPort: #R NO#!"
					}

					text_single = {
						visible = "[And(Trade.GetToPort.IsValid, Trade.GetToPort.GetPortSeaZone.IsValid)]"
						raw_text = "#G ToPort SeaZone: [Trade.GetToPort.GetPortSeaZone.GetNameWithNoTooltip]#!"
					}
					text_single = {
						visible = "[And(Trade.GetToPort.IsValid, Not(Trade.GetToPort.GetPortSeaZone.IsValid))]"
						raw_text = "#R ToPort SeaZone: NONE / INVALID#!"
					}

					text_single = {
						raw_text = "#Y --- CANDIDATE CLASSIFIER ---#!"
					}
					text_single = {
						visible = "[Or(And(Trade.GetFromPort.IsValid, Trade.GetFromPort.GetPortSeaZone.IsValid), And(Trade.GetToPort.IsValid, Trade.GetToPort.GetPortSeaZone.IsValid))]"
						raw_text = "#G CANDIDATE SHIPPING: YES#!"
					}
					text_single = {
						visible = "[Not(Or(And(Trade.GetFromPort.IsValid, Trade.GetFromPort.GetPortSeaZone.IsValid), And(Trade.GetToPort.IsValid, Trade.GetToPort.GetPortSeaZone.IsValid)))]"
						raw_text = "#R CANDIDATE SHIPPING: NO#!"
					}

					text_single = {
						raw_text = "#Y --- GUI -> JOMINI BRIDGE TEST ---#!"
					}

					button_default = {
						layoutpolicy_horizontal = expanding
						size = { -1 30 }
						visible = "[Or(And(Trade.GetFromPort.IsValid, Trade.GetFromPort.GetPortSeaZone.IsValid), And(Trade.GetToPort.IsValid, Trade.GetToPort.GetPortSeaZone.IsValid))]"
						onclick = "[GetScriptedGui('eu5ts_debug_bridge_maritime').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('trade', Trade.MakeScope).AddScope('from_market', Trade.GetFromMarket.MakeScope).AddScope('to_market', Trade.GetToMarket.MakeScope).End)]"
						tooltip = "EU5TS_DEBUG_BRIDGE_TT"
						hbox = {
							layoutpolicy_horizontal = expanding
							text_single = {
								size = { 100% 100% }
								align = center|nobaseline
								text = "EU5TS_DEBUG_RUN_MARITIME_BRIDGE"
							}
						}
					}

					button_default = {
						layoutpolicy_horizontal = expanding
						size = { -1 30 }
						visible = "[Not(Or(And(Trade.GetFromPort.IsValid, Trade.GetFromPort.GetPortSeaZone.IsValid), And(Trade.GetToPort.IsValid, Trade.GetToPort.GetPortSeaZone.IsValid)))]"
						onclick = "[GetScriptedGui('eu5ts_debug_bridge_land').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('trade', Trade.MakeScope).AddScope('from_market', Trade.GetFromMarket.MakeScope).AddScope('to_market', Trade.GetToMarket.MakeScope).End)]"
						tooltip = "EU5TS_DEBUG_BRIDGE_TT"
						hbox = {
							layoutpolicy_horizontal = expanding
							text_single = {
								size = { 100% 100% }
								align = center|nobaseline
								text = "EU5TS_DEBUG_RUN_LAND_BRIDGE"
							}
						}
					}

					text_single = {
						visible = "[Not(GetPlayer.MakeScope.GetVariable('eu5ts_debug_bridge_ran').IsSet)]"
						raw_text = "Bridge status: #Y NOT RUN YET#!"
					}
					text_single = {
						visible = "[GetPlayer.MakeScope.GetVariable('eu5ts_debug_bridge_ran').IsSet]"
						raw_text = "Bridge status: #G JOMINI EFFECT EXECUTED#!"
					}
					text_single = {
						visible = "[GetPlayer.MakeScope.GetVariable('eu5ts_debug_bridge_maritime').IsSet]"
						raw_text = "Last bridged classifier result: #G MARITIME#!"
					}
					text_single = {
						visible = "[GetPlayer.MakeScope.GetVariable('eu5ts_debug_bridge_land').IsSet]"
						raw_text = "Last bridged classifier result: #R LAND#!"
					}

					text_single = {
						visible = "[GetPlayer.MakeScope.GetVariable('eu5ts_debug_bridge_trade_scope_ok').IsSet]"
						raw_text = "scope:trade received by Jomini: #G YES#!"
					}
					text_single = {
						visible = "[And(GetPlayer.MakeScope.GetVariable('eu5ts_debug_bridge_ran').IsSet, Not(GetPlayer.MakeScope.GetVariable('eu5ts_debug_bridge_trade_scope_ok').IsSet))]"
						raw_text = "scope:trade received by Jomini: #R NO#!"
					}

					text_single = {
						visible = "[GetPlayer.MakeScope.GetVariable('eu5ts_debug_bridge_from_market_scope_ok').IsSet]"
						raw_text = "scope:from_market received: #G YES#!"
					}
					text_single = {
						visible = "[And(GetPlayer.MakeScope.GetVariable('eu5ts_debug_bridge_ran').IsSet, Not(GetPlayer.MakeScope.GetVariable('eu5ts_debug_bridge_from_market_scope_ok').IsSet))]"
						raw_text = "scope:from_market received: #R NO#!"
					}

					text_single = {
						visible = "[GetPlayer.MakeScope.GetVariable('eu5ts_debug_bridge_to_market_scope_ok').IsSet]"
						raw_text = "scope:to_market received: #G YES#!"
					}
					text_single = {
						visible = "[And(GetPlayer.MakeScope.GetVariable('eu5ts_debug_bridge_ran').IsSet, Not(GetPlayer.MakeScope.GetVariable('eu5ts_debug_bridge_to_market_scope_ok').IsSet))]"
						raw_text = "scope:to_market received: #R NO#!"
					}

					text_single = {
						raw_text = "#Y --- DIRECTED ROUTE CACHE ---#!"
					}
					text_single = {
						visible = "[GetPlayer.MakeScope.GetVariable('eu5ts_debug_route_cache_write_ok').IsSet]"
						raw_text = "Jomini cache write attempted: #G YES#!"
					}
					text_single = {
						visible = "[Not(Trade.GetFromMarket.MakeScope.GetVariableFromVariableMap('eu5ts_shipping_routes', Trade.GetToMarket.MakeScope).IsSet)]"
						raw_text = "Cache readback for this From->To pair: #Y NOT CACHED#!"
					}
					text_single = {
						visible = "[And(Trade.GetFromMarket.MakeScope.GetVariableFromVariableMap('eu5ts_shipping_routes', Trade.GetToMarket.MakeScope).IsSet, EqualTo_CFixedPoint(Trade.GetFromMarket.MakeScope.GetVariableFromVariableMap('eu5ts_shipping_routes', Trade.GetToMarket.MakeScope).GetValue, '(CFixedPoint)1'))]"
						raw_text = "Cache readback for this From->To pair: #G MARITIME (1)#!"
					}
					text_single = {
						visible = "[And(Trade.GetFromMarket.MakeScope.GetVariableFromVariableMap('eu5ts_shipping_routes', Trade.GetToMarket.MakeScope).IsSet, EqualTo_CFixedPoint(Trade.GetFromMarket.MakeScope.GetVariableFromVariableMap('eu5ts_shipping_routes', Trade.GetToMarket.MakeScope).GetValue, '(CFixedPoint)0'))]"
						raw_text = "Cache readback for this From->To pair: #R LAND (0)#!"
					}

					text_single = {
						raw_text = "#Y Goal: prove GUI classifier -> Jomini scope bridge -> persistent directed Market-pair cache -> GUI readback.#!"
						default_format = "#flavor"
					}
				}
			}

			expand = {}
		}
	}
}
